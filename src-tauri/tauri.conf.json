{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Optimizer",
  "version": "0.1.0",
  "identifier": "com.prompt-optimizer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prompt Optimizer",
        "width": 800,
        "height": 600,
        "center": true,
        "visible": true,
        "resizable": true,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
        "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
